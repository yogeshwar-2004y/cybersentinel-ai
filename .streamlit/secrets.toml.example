# Copy to secrets.toml, use values from your organization identity provider,
# generate a strong cookie secret, and set REQUIRE_AUTH=true in .env.
[auth]
redirect_uri = "http://127.0.0.1:8501/oauth2callback"
cookie_secret = "replace-with-a-generated-secret"
client_id = "your-oidc-client-id"
client_secret = "your-oidc-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
