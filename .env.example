# No API key required for local mode.
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434

# auto: use a cached Sentence Transformer, otherwise offline hashing.
# sentence_transformer: require semantic model; hashing: lightweight offline retrieval.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ALLOW_MODEL_DOWNLOAD=false
TOP_K=5
CONTAMINATION=0.08

# Cloud use requires explicit opt-in; redaction is best effort.
ALLOW_CLOUD_LOGS=false
ALLOW_LOCAL_FALLBACK=true
# Optional absolute path for persistent runtime data:
# STATE_DIR=/var/lib/cybersentinel

# Optional built-in OIDC gate, configured in .streamlit/secrets.toml
REQUIRE_AUTH=false
